<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Base obsidian profunda (#070B14) -->
    <path
        android:fillColor="#070B14"
        android:pathData="M0,0h108v108h-108z" />

    <!-- Halo radial sutil azul elétrico ao centro -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="46"
                android:type="radial">
                <item android:color="#142952" android:offset="0.0" />
                <item android:color="#0A1428" android:offset="0.58" />
                <item android:color="#070B14" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Aro externo difuso azul elétrico (#2563EB) dentro da safe zone do adaptive icon -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M54,23.5 A30.5,30.5 0 1,1 53.99,23.5 Z"
        android:strokeAlpha="0.52"
        android:strokeColor="#2563EB"
        android:strokeWidth="4.4" />

    <!-- Aro principal geométrico ciano/azul neon (#00D4FF -> #2563EB) -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M54,24.5 A29.5,29.5 0 1,1 53.99,24.5 Z"
        android:strokeWidth="2.1">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="84"
                android:endY="84"
                android:startX="24"
                android:startY="24"
                android:type="linear">
                <item android:color="#00D4FF" android:offset="0.0" />
                <item android:color="#38BDF8" android:offset="0.45" />
                <item android:color="#2563EB" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Núcleo obsidian de contraste máximo para o monograma central -->
    <path
        android:fillAlpha="0.62"
        android:fillColor="#070B14"
        android:pathData="M54,26.2 A27.8,27.8 0 1,1 53.99,26.2 Z" />
</vector>
